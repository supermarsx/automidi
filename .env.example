# AutoMIDI Environment Configuration

# ===========================================
# Command Execution Settings
# ===========================================

# Comma-separated list of allowed commands for shell execution
# Only these commands can be executed via the runApp/runShell macros
# Example: notepad,calc,ffmpeg,code,obs
ALLOWED_CMDS=notepad,calc

# Rate limiting for command execution
# Maximum number of commands allowed per interval
CMD_RATE_LIMIT=5

# Rate limiting interval in milliseconds
CMD_RATE_INTERVAL_MS=1000

# ===========================================
# Development Settings
# ===========================================

# Enable MIDI message logging (for debugging)
# LOG_MIDI=true

# ===========================================
# Server Settings (WebSocket mode only)
# ===========================================

# Port for WebSocket server
# PORT=3000

# API key for WebSocket authentication (optional)
# API_KEY=your-secret-key-here

# ===========================================
# Notes
# ===========================================
# 
# - In Tauri mode, these settings are read at application startup
# - Changes require restarting the application
# - Keep API_KEY secret and never commit it to version control
# - Add more commands to ALLOWED_CMDS as needed for your macros
